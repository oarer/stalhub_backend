RESTIC_PASSWORD=CHANGE_ME

RESTIC_REPOSITORY=s3:https://s3.ru1.storage.beget.cloud/

AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=ru-1

# Discord-алерты о провалах (или ADMIN_ALERT_WEBHOOK):
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Ротация: 60 снапшотов = 30 дней x2/сутки:
# KEEP_LAST=60
# --- Фулл-бэкап: логи ---
# BACKUP_LOGS=1
# NGINX_LOG_DIR=/var/log/nginx
# BACKUP_DOCKER_LOGS=1
# DOCKER_LOG_CONTAINERS="StalHub_backend StalHub_image_service StalHub_discord_bot"
# DOCKER_LOGS_SINCE=720h
# BACKUP_SELF_LOG=1
# LOG_WARN_MB=2048
