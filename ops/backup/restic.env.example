# Скопировать в /root/.restic.env на проде, chmod 600. НЕ коммитить.
#
# Пароль репозитория restic (сгенерировать: openssl rand -base64 32):
RESTIC_PASSWORD=CHANGE_ME
#
# S3-бакет бэкапов (Beget: endpoint https://s3.ru1.storage.beget.cloud, регион ru1).
# Бакет БЭКАПОВ — отдельный, приватный (публичный тумблер ВЫКЛ).
RESTIC_REPOSITORY=s3:https://s3.ru1.storage.beget.cloud/
# Ключи именно бакета бэкапов (у каждого бакета Beget свои ключи):
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=ru-1
#
# Шифрование .env через age (опционально, но рекомендовано):
# AGE_RECIPIENTS="age1..."
# Discord-алерты о провалах (или ADMIN_ALERT_WEBHOOK):
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Ротация: 60 снапшотов = 30 дней x2/сутки:
# KEEP_LAST=60
# --- Фулл-бэкап: логи ---
# BACKUP_LOGS=1
# NGINX_LOG_DIR=/var/log/nginx
# BACKUP_DOCKER_LOGS=1
# DOCKER_LOG_CONTAINERS="StalHub_backend StalHub_image_service StalHub_discord_bot"
# DOCKER_LOGS_SINCE=720h
# BACKUP_SELF_LOG=1
# LOG_WARN_MB=2048
