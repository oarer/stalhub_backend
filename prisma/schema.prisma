generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlayerRole {
  EXBO
  MEDIA
  SCAMMER
  STALHUB
  SPONSOR
  HELPER
  BUGBOUNTY
}

enum NotificationType {
  INFO
  WARN
  DANGER
}

enum AvatarSource {
  DISCORD
  TELEGRAM
}

enum StarTargetType {
  BUILD
  ARTICLE
  ART
}

enum CardBackground {
  COLOR
  AVATAR
  NONE
}

enum BannerMode {
  COLOR
  IMAGE
  NONE
}

enum BannerType {
  BACKGROUND
  HEADER
}

enum UserLayout {
  CLASSIC
  MODERN
  COMPACT
}

enum ArticleStatus {
  PENDING
  APPROVED
  REVIEW
  DENIED
  BANNED
}

enum ArticleType {
  QUEST
  GUIDE
  OTHER
  STALHUB
  FACTION
}

enum QuestType {
  STORY
  SIDE
}

enum Faction {
  BANDITS
  STALKERS
  ALL
}

enum TierRank {
  S
  A
  B
  C
  D
  E
}

enum TierListKind {
  SYSTEM
  USER
}

enum TierItemKind {
  ARMOR
  WEAPON
}

enum ArtType {
  DEFAULT
  NSFW
}

enum ClanStatus {
  FROZEN
  ACTIVE
}

enum ClanTier {
  E
  D
  C
  B
  A
  S
}

enum StageType {
  TOURNAMENT
  BRAWL
  BASE_CAPTURE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum SquadMap {
  SMALL_BERDOVKA
  KHVOUINOY
  NIZINA
}

enum GoldDropStatus {
  PENDING
  CLAIMED
}

enum BoostMode {
  ISSUED
  SELF
}

// ================ USER MODEL ===================
model User {
  id                  Int      @id @default(autoincrement())
  username            String   @unique @default("")
  username_changed_at DateTime @default(now())
  name                String   @default("") // display name
  onboarded           Boolean  @default(false)
  social_links        Json? // { network: url } record of social links
  password_hash       String?

  sessions      Sessions[]
  user_settings UserSettings?
  customization UserCustomization?
  notifications Notifications[]    @relation("Notifications")
  joined_at     DateTime           @default(now())

  roles Role[]

  // Auth providers
  discord_auth  DiscordAuth?
  telegram_auth TelegramAuth?
  exbo_auth     EXBOAuth?

  badges UserBadges[]

  builds           Build[]
  articles         Article[]
  arts             Art[]
  tier_lists       TierList[]
  stars            Star[]
  comments         ArticleComment[]
  profile_comments ArticleComment[] @relation("ProfileComments")

  clan_profiles  UserClanProfile[]
  loadout        UserLoadout?
  absences       Absence[]
  clan_members   ClanMember[]
  stage_sessions StageSession[]
  attendance     StageAttendance[]
  clan_history   ClanHistory[]
  clan_invite    ClanInvite?
  authored_notes ClanMemberNote[]
}

model UserBadges {
  id    Int     @id @default(autoincrement())
  name  String
  icon  String?
  image String?
  color String  @default("#0ea5e9")
  users User[]
}

model UserSettings {
  id      Int  @id @default(autoincrement())
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id Int  @unique

  banned         Boolean   @default(false)
  ban_reason     String?
  ban_expires_at DateTime?

  public_profile Boolean @default(false)
}

model UserCustomization {
  id      Int  @id @default(autoincrement())
  user_id Int  @unique
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  layout UserLayout @default(CLASSIC)

  banner_mode  BannerMode @default(NONE)
  banner_type  BannerType @default(HEADER)
  banner_color String     @default("#171717")
  banner_image String?

  card_background CardBackground @default(NONE)
  card_color      String         @default("#171717")
  avatar          AvatarSource?
  avatar_image    String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Sessions {
  id         Int    @id @default(autoincrement())
  session_id String @unique @default("")

  user_agent String @default("")
  ip         String @default("")
  user       User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id    Int

  last_used_at DateTime @default(now())
  revoked      Boolean  @default(false)
}

model Notifications {
  id         Int      @id @default(autoincrement())
  users      User[]   @relation("Notifications")
  title      String   @default("")
  content    String   @default("")
  author     String   @default("Система")
  type       Int      @default(0)
  read       Boolean  @default(false)
  link       String?
  created_at DateTime @default(now())
}

// ================ RBAC ===================
model Role {
  id          Int    @id @default(autoincrement())
  name        String @unique
  description String @default("")
  rank        Int    @default(0)

  users       User[]
  permissions Permission[]

  @@map("role")
}

model Permission {
  id          Int    @id @default(autoincrement())
  name        String @unique
  description String @default("")

  roles Role[]

  @@map("permission")
}

// ================ END RBAC ===================

// =================== AUTH PROVIDERS ===================

model DiscordAuth {
  id         Int     @id @default(autoincrement())
  discord_id String  @unique
  name       String
  username   String
  avatar_id  String?

  user   User @relation(fields: [userid], references: [id], onDelete: Cascade)
  userid Int  @unique

  connected_at DateTime @default(now())
}

model TelegramAuth {
  id          Int    @id @default(autoincrement())
  telegram_id String @unique

  name      String
  login     String?
  avatar_id String?

  user   User @relation(fields: [userid], references: [id], onDelete: Cascade)
  userid Int  @unique

  connected_at DateTime @default(now())
}

model EXBOAuth {
  id Int @id @default(autoincrement())

  exbo_id  String @unique
  login    String @default("")
  username String @default("")

  token_blob String

  region            String?
  region_changed_at DateTime?

  access_expires_at  DateTime
  refresh_expires_at DateTime?

  user   User @relation(fields: [userid], references: [id], onDelete: Cascade)
  userid Int  @unique

  connected_at DateTime @default(now())
  updated_at   DateTime @updatedAt
}

model EXBOAuthState {
  id String @id @default(cuid())

  state String @unique

  expires_at DateTime

  created_at DateTime @default(now())
}

// =============== END OF AUTH PROVIDERS ================

model Build {
  id          Int    @id @default(autoincrement())
  external_id String @unique

  title String
  data  String

  flags Int    @default(0)
  tags  String @default("")
  views Int    @default(0)

  author    User @relation(fields: [author_id], references: [id], onDelete: Cascade)
  author_id Int

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("builds")
}

model Article {
  id            Int           @id @default(autoincrement())
  external_id   String        @unique
  status        ArticleStatus @default(PENDING)
  status_reason String?
  type          ArticleType   @default(OTHER)

  title     String
  content   String
  image_url String?

  quest_name   String?
  quest_type   QuestType?
  quest_map    Json?
  reward_text  String?
  reward_money Int?
  faction      Faction?

  flags Int    @default(0)
  tags  String @default("")
  views Int    @default(0)

  author    User @relation(fields: [author_id], references: [id], onDelete: Cascade)
  author_id Int

  versions ArticleVersion[]
  comments ArticleComment[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("articles")
}

model Art {
  id          Int     @id @default(autoincrement())
  external_id String  @unique
  type        ArtType @default(DEFAULT)

  title       String?
  description String?
  image_url   String?

  tags  String @default("")
  views Int    @default(0)

  author    User? @relation(fields: [author_id], references: [id], onDelete: SetNull)
  author_id Int?

  author_name         String?
  author_social_links Json?

  comments ArticleComment[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("arts")
}

model ArticleVersion {
  id      Int    @id @default(autoincrement())
  version String
  content String

  article    Article @relation(fields: [article_id], references: [id], onDelete: Cascade)
  article_id Int

  created_at DateTime @default(now())

  @@map("article_versions")
}

model ArticleComment {
  id      Int    @id @default(autoincrement())
  content String

  author    User @relation(fields: [author_id], references: [id], onDelete: Cascade)
  author_id Int

  article    Article? @relation(fields: [article_id], references: [id], onDelete: Cascade)
  article_id Int?

  art    Art? @relation(fields: [art_id], references: [id])
  art_id Int?

  profile_user    User? @relation("ProfileComments", fields: [profile_user_id], references: [id], onDelete: Cascade)
  profile_user_id Int?

  parent    ArticleComment?  @relation("CommentReplies", fields: [parent_id], references: [id], onDelete: Cascade)
  parent_id Int?
  replies   ArticleComment[] @relation("CommentReplies")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([profile_user_id])
  @@map("article_comments")
}

model Star {
  id          Int            @id @default(autoincrement())
  target_type StarTargetType
  target_id   Int

  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id Int

  created_at DateTime @default(now())

  @@unique([target_type, target_id, user_id])
  @@map("stars")
}

// ================ END BUILDS/ARTICLES ===================

// ================ END OF USER MODEL ===================
model PlayerNote {
  id          String     @id @default(cuid())
  uuid        String     @unique
  role        PlayerRole @default(SCAMMER)
  description String?
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
}

model PopularPlayer {
  id         String   @id @default(cuid())
  uuid       String   @unique
  username   String
  alliance   String
  region     String
  views      Int      @default(0)
  updated_at DateTime @updatedAt
}

model PlayerBlacklist {
  id         String   @id @default(cuid())
  uuid       String   @unique
  created_at DateTime @default(now())
}

// ================ CLAN ANALYTICS ===================

model Clan {
  id           String     @id // EXBO clan id
  name         String
  tag          String     @default("")
  level        Int        @default(0)
  level_points Int        @default(0)
  alliance     String     @default("")
  description  String     @default("")
  leader       String     @default("")
  member_count Int        @default(0)
  region       String     @default("RU")
  status       ClanStatus @default(FROZEN)

  is_public     Boolean @default(false)
  recruiting    Boolean @default(false)
  public_fields Json    @default("[]")

  leader_discord   String   @default("")
  clan_discord     String?
  paid_recruitment Boolean  @default(false)
  rating           Int      @default(0)
  tier             ClanTier @default(E)
  guilds_per_week  Int?

  blocked      Boolean   @default(false)
  block_reason String?
  blocked_at   DateTime?

  schedule Json?

  boost_mode   BoostMode @default(ISSUED)
  grenade_mode BoostMode @default(ISSUED)

  members       ClanMember[]
  sessions      StageSession[]
  rating_events ClanRatingEvent[]
  squads        ClanSquad[]
  profile       UserClanProfile[]

  boost_orders ClanBoostOrder[]

  synced_at  DateTime @updatedAt
  created_at DateTime @default(now())

  @@map("clans")
}

model ClanMember {
  id        Int       @id @default(autoincrement())
  clan      Clan      @relation(fields: [clan_id], references: [id], onDelete: Cascade)
  clan_id   String
  name      String
  rank      String    @default("")
  join_time DateTime?

  user    User? @relation(fields: [user_id], references: [id], onDelete: SetNull)
  user_id Int?  @unique

  synced_at          DateTime           @updatedAt
  clan_squad_members ClanSquadMember[]
  squad_requests     ClanSquadRequest[]
  gold_attendances   GoldDropAttendee[]
  notes              ClanMemberNote[]
  boost_orders       ClanBoostOrder[]

  @@unique([clan_id, name])
  @@map("clan_members")
}

model ClanHistory {
  id Int @id @default(autoincrement())

  player_name String
  region      String @default("RU")

  clan_id   String
  clan_name String
  clan_tag  String @default("")
  alliance  String @default("")

  rank      String    @default("")
  joined_at DateTime?

  seen_at DateTime @default(now())

  user    User? @relation(fields: [user_id], references: [id], onDelete: SetNull)
  user_id Int?

  @@index([user_id, seen_at])
  @@index([player_name, seen_at])
  @@map("clan_history")
}

model UserClanProfile {
  user      User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id   Int
  clan      Clan    @relation(fields: [clan_id], references: [id], onDelete: Cascade)
  clan_id   String
  region    String  @default("RU")
  is_active Boolean @default(false)

  updated_at DateTime @updatedAt

  @@id([user_id, clan_id])
  @@map("user_clan_profile")
}

// ================ STAGE SESSIONS / AI ANALYSIS ===================

model StageSession {
  id           Int       @id @default(autoincrement())
  external_id  String    @unique @default(cuid())
  region       String    @default("RU")
  map_name     String
  type         StageType @default(TOURNAMENT)
  started_at   DateTime  @default(now())
  ended_at     DateTime?
  stage_number Int?

  creator    User?   @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  creator_id Int?
  clan       Clan?   @relation(fields: [clan_id], references: [id], onDelete: SetNull)
  clan_id    String?

  screenshots  StageScreenshot[]
  attendance   StageAttendance[]
  rating_event ClanRatingEvent?
  ai_summary   Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("stage_sessions")
}

model ClanSeason {
  id         Int      @id @default(autoincrement())
  name       String
  starts_at  DateTime
  ends_at    DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  rating_events ClanRatingEvent[]

  @@index([starts_at, ends_at])
  @@map("clan_seasons")
}

model ClanRatingEvent {
  id         Int          @id @default(autoincrement())
  clan       Clan         @relation(fields: [clan_id], references: [id], onDelete: Cascade)
  clan_id    String
  season     ClanSeason   @relation(fields: [season_id], references: [id], onDelete: Restrict)
  season_id  Int
  session    StageSession @relation(fields: [session_id], references: [id], onDelete: Restrict)
  session_id Int          @unique
  delta      Int
  created_at DateTime     @default(now())

  @@index([clan_id, season_id])
  @@map("clan_rating_events")
}

model StageScreenshot {
  id         Int          @id @default(autoincrement())
  session    StageSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  session_id Int          @unique

  file_path  String
  mime_type  String @default("image/png")
  size_bytes Int    @default(0)

  ai_result Json?
  ai_status String  @default("pending")
  ai_error  String?

  created_at DateTime @default(now())

  @@map("stage_screenshots")
}

model StageAttendance {
  id         Int          @id @default(autoincrement())
  session    StageSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  session_id Int
  name       String       @default("")
  user       User?        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id    Int?

  status AttendanceStatus @default(PRESENT)
  source String           @default("ai") // ai | manual
  note   String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([session_id, name])
  @@map("stage_attendance")
}

// ================ CLAN SQUADS ===================

model ClanSquad {
  id         Int      @id @default(autoincrement())
  clan_id    String
  map        SquadMap @default(SMALL_BERDOVKA)
  name       String
  created_by Int

  leader_id Int?             @unique
  leader    ClanSquadMember? @relation("SquadLeader", fields: [leader_id], references: [id], onDelete: SetNull)

  clan     Clan               @relation(fields: [clan_id], references: [id], onDelete: Cascade)
  members  ClanSquadMember[]
  requests ClanSquadRequest[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([clan_id, map, name])
  @@map("clan_squads")
}

model ClanSquadMember {
  id       Int @id @default(autoincrement())
  squad_id Int
  slot     Int

  member_id Int
  member    ClanMember @relation(fields: [member_id], references: [id], onDelete: Cascade)

  gear_override Json?

  squad      ClanSquad  @relation(fields: [squad_id], references: [id], onDelete: Cascade)
  leader_for ClanSquad? @relation("SquadLeader")

  @@unique([squad_id, slot])
  @@unique([squad_id, member_id])
  @@map("clan_squad_members")
}

model ClanSquadRequest {
  id        Int @id @default(autoincrement())
  squad_id  Int
  member_id Int

  squad  ClanSquad  @relation(fields: [squad_id], references: [id], onDelete: Cascade)
  member ClanMember @relation(fields: [member_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@unique([squad_id, member_id])
  @@map("clan_squad_requests")
}

// ================ GOLD DROPS ===================

model GoldDrop {
  id      Int            @id @default(autoincrement())
  clan_id String
  date    DateTime
  status  GoldDropStatus @default(PENDING)

  attendees GoldDropAttendee[]

  created_at DateTime @default(now())

  @@index([clan_id, date])
  @@map("gold_drops")
}

model GoldDropAttendee {
  id        Int @id @default(autoincrement())
  drop_id   Int
  member_id Int

  drop   GoldDrop   @relation(fields: [drop_id], references: [id], onDelete: Cascade)
  member ClanMember @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@unique([drop_id, member_id])
  @@map("gold_drop_attendees")
}

// ================ ABSENCES (отписки) ===================

model Absence {
  id      Int     @id @default(autoincrement())
  clan_id String
  user_id Int
  date    String
  events  Json
  note    String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, date])
  @@index([clan_id, date])
  @@map("absences")
}

// ================ DISCORD BOT GUILDS ===================

model BotGuild {
  id                 Int     @id @default(autoincrement())
  guild_id           String  @unique
  clan_id            String
  allowed_role_id    String?
  publish_time       String? // HH:MM MSK
  publish_channel_id String?
  stages_channel_id  String?
  linked_by          String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("bot_guilds")
}

model ClanInvite {
  id         Int       @id @default(autoincrement())
  code       String    @unique
  clan_id    String
  user_id    Int       @unique
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  claimed_by String?
  claimed_at DateTime?
  created_by String    @default("")
  created_at DateTime  @default(now())

  @@map("clan_invites")
}

model BotLinkState {
  id         String   @id @default(cuid())
  token      String   @unique
  clan_id    String
  user_id    Int?
  expires_at DateTime

  created_at DateTime @default(now())

  @@map("bot_link_states")
}

// ================ GRENADE SNAPSHOTS ===================

model GrenadeSnapshot {
  id         Int       @id @default(autoincrement())
  clan_id    String
  event_type StageType
  checkpoint String
  raid_date  DateTime
  members    Json

  created_at DateTime @default(now())

  @@index([clan_id, raid_date])
  @@map("grenade_snapshots")
}

// ================ CLAN MEMBER NOTES ===================

model ClanMemberNote {
  id        Int    @id @default(autoincrement())
  clan_id   String
  member_id Int
  author_id Int
  content   String

  member ClanMember @relation(fields: [member_id], references: [id], onDelete: Cascade)
  author User       @relation(fields: [author_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([member_id])
  @@index([clan_id])
  @@map("clan_member_notes")
}

// ORDERS
model GrenadeBox {
  id      Int    @id @default(autoincrement())
  clan_id String
  date    String
  name    String
  type    String
  count   Int    @default(1)

  created_at DateTime @default(now())

  @@index([clan_id, date])
  @@map("grenade_boxes")
}

model ClanBoostOrder {
  id        Int    @id @default(autoincrement())
  clan_id   String
  date      String
  player_id Int
  item_id   String
  item_name String
  count     Int    @default(1)

  player ClanMember @relation(fields: [player_id], references: [id], onDelete: Cascade)
  clan   Clan       @relation(fields: [clan_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@index([clan_id, date])
  @@map("clan_boost_orders")
}

// ================ LOADOUT ===================

model UserLoadout {
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id Int  @id

  data      Json    @default("{}")
  is_public Boolean @default(false)

  updated_at DateTime @updatedAt

  @@map("user_loadout")
}

// ================ TIER LISTS ===================

model TierList {
  id          Int          @id @default(autoincrement())
  external_id String       @unique
  title       String
  description String       @default("")
  views       Int          @default(0)
  kind        TierListKind @default(USER)
  item_kind   TierItemKind @default(WEAPON)
  is_public   Boolean      @default(true)
  scenario    String?
  category    String?

  generated_at  DateTime?
  source_commit String?
  is_current    Boolean   @default(false)
  removed_at    DateTime?

  author    User? @relation(fields: [author_id], references: [id], onDelete: SetNull)
  author_id Int?

  entries TierListEntry[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("tier_lists")
}

model TierListHistory {
  id           Int          @id @default(autoincrement())
  external_id  String
  title        String
  description  String       @default("")
  item_kind    TierItemKind @default(WEAPON)
  category     String?
  scenario     String?
  generated_at DateTime
  removed_at   DateTime     @default(now())

  entries Json /// [{ item_id, rank, position }]

  created_at DateTime @default(now())

  @@map("tier_list_history")
}

model TierListEntry {
  id           Int      @id @default(autoincrement())
  tier_list_id Int
  item_id      String
  rank         TierRank
  ttk          Float?
  position     Int      @default(0)

  tier_list TierList @relation(fields: [tier_list_id], references: [id], onDelete: Cascade)

  @@unique([tier_list_id, item_id])
  @@map("tier_list_entries")
}

// всё будет хорошо
